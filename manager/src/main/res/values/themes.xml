<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Настоящий MD3 (ТЗ §21.1): Material3 DayNight + динамические цвета
      применяются через ThemeApplier/DynamicColors на Android 12+.
      Светлая и тёмная схемы обязательны и обеспечиваются DayNight-родителем.
    -->
    <style name="Theme.Moduled" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.Moduled.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Widget.Moduled.Body" parent="TextAppearance.Material3.BodyMedium" />

    <style name="Widget.Moduled.MonoBody" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:typeface">monospace</item>
    </style>
</resources>
